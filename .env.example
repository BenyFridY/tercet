# NUNCA coloque valores reais aqui nem em .env dentro desta pasta (sincronizada
# pelo OneDrive). Os segredos reais vivem FORA do sync, em C:\dev\mesa.env —
# que o config.py lê com precedência. Este arquivo só documenta as chaves.
RPC_URL=https://sepolia.base.org
RPC_URL_MAINNET=https://mainnet.base.org
FACILITATOR_URL=https://x402.org/facilitator
DATABASE_URL=postgresql://mesa:mesa@localhost:5433/mesa
# Fase 1 — comprador e vendedor de teste (testnet; scripts/setup_wallets.py gera)
BUYER_PK=
BUYER_ADDRESS=
SELLER_PK=
SELLER_PAYTO=
# Fase 2 — carteira do servidor MCP (compra delegada) e o agente
MCP_SERVER_PK=
MCP_SERVER_ADDRESS=
ANTHROPIC_API_KEY=
# Fase 3 — carteira EXCLUSIVA do censo (mainnet, dinheiro real, tetos duros)
CENSUS_PK=
CENSUS_ADDRESS=
